# Environment Configuration for ClubDocs Platform

# Application Environment: 'development' | 'production' | 'test'
ENVIRONMENT=development

# Database URL (PostgreSQL via Docker or local; SQLite as fallback)
# DATABASE_URL=postgresql://clubdocs_user:clubdocs_password@localhost:5432/clubdocs
DATABASE_URL=sqlite:///data/clubdocs.db

# Security Secrets (REQUIRED in production - generate with `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
JWT_SECRET_KEY=generate-a-secure-random-jwt-secret-in-production
# Field Encryption Key must be a valid 32-byte urlsafe base64-encoded key for Fernet
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=generate-a-valid-fernet-key-in-production

# Server Settings
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8000

# Gemini AI API Key (Optional in development, required for live LLM template generation)
# Get a key from: https://aistudio.google.com/
# GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model Setting (Default: gemini-2.5-flash)
# Configures the Google Gemini model used for template drafting and extraction
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth Sign-in & Domain Restriction
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAIN=svnit.ac.in


