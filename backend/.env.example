# ClubDocs backend settings. Copy to .env for local development.
# On Render these are set in the dashboard (see render.yaml and docs/DEPLOYMENT.md).

# 'development' | 'production' | 'test'
ENVIRONMENT=development

# Database: SQLite locally; on Supabase use the Session pooler link with ?sslmode=require
DATABASE_URL=sqlite:///data/clubdocs.db
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# Secrets (required in production)
# JWT:    python -c "import secrets; print(secrets.token_urlsafe(32))"
# Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#         Keep the Fernet key forever: changing it makes stored sensitive fields unreadable.
JWT_SECRET_KEY=generate-a-secure-random-jwt-secret-in-production
FIELD_ENCRYPTION_KEY=generate-a-valid-fernet-key-in-production

# Public website address, used in emailed links (the Vercel URL in production)
APP_BASE_URL=http://localhost:5173
# Browser origins allowed to call the API directly (not needed when Vercel proxies /api)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000

# Google sign-in (the client ID is public; no client secret is used)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAIN=svnit.ac.in
# These Google-verified emails become platform admins when they sign in
# PLATFORM_ADMIN_EMAILS=you@coed.svnit.ac.in

# Gemini AI (optional locally; https://aistudio.google.com/)
# GEMINI_API_KEY=your-gemini-api-key-here
# More keys = more free quota: list several separated by commas, or add GEMINI_API_KEY_2 ... _9.
# Every key is tried in order (all Gemini keys, then all Groq keys) when one hits its limit.
# GEMINI_API_KEY_2=second-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq AI fallback (optional; https://console.groq.com)
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_API_KEY_2=second-groq-key
# GROQ_MODEL=openai/gpt-oss-120b
# AI_TEMPERATURE=0
# AI_CACHE_ENABLED=true

# File storage: 'local' (disk) or 's3' (local working copy mirrored to Supabase Storage / S3)
STORAGE_BACKEND=local
# S3_BUCKET=clubdocs
# S3_ENDPOINT_URL=https://PROJECT.supabase.co/storage/v1/s3
# AWS_REGION=ap-south-1
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...

# Server sizing (512 MB hosts: 1 and 1)
# WEB_CONCURRENCY=2
# PDF_CONVERT_SLOTS=2

# Email (optional; without SMTP_HOST, emails are printed to the server log)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# SMTP_FROM=clubdocs@your-domain
